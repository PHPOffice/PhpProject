{
    "name": "phpoffice/phpproject",
    "description": "PHPProject - Read, Create and Write Project Management documents in PHP",
    "keywords": ["PHP","Project","GanttProject","gan","mpx"],
    "homepage": "http://phpoffice.github.io",
    "type": "library",
    "license": "LGPL-3.0-only",    
    "authors": [
        {
            "name": "Mark Baker"
        },
        {
            "name": "Franck Lefevre",
            "homepage": "http://rootslabs.net"
        }
    ],
    "require": {
        "php": ">=7.3",
        "ext-xml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",        
        "phpmd/phpmd": "^2.15",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "PhpOffice\\PhpProject\\": "src/PhpProject/"
        }
    },
    "scripts": {
        "samples": [            
            "php samples/Sample_01_Simple.php",
            "php samples/Sample_02_ReadGanttProject.php",
            "php samples/Sample_02_ReadMSProjectExchange.php"         
        ]
    }
}
